# Hardened Ocado-only MCP server. Build context is the repo root.
# Base images are pinned to digests (tag kept for readability; the digest wins).

# Build stage: compile only the hardened entry point and what it imports.
FROM node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY tsconfig.json tsconfig.hardened.json ./
COPY src ./src
RUN npx tsc -p tsconfig.hardened.json

# Runtime stage: production dependencies only, minus browser automation and CLI packages.
FROM node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm uninstall --ignore-scripts --no-audit --no-fund \
      playwright playwright-extra puppeteer-extra-plugin-stealth chalk commander \
 && npm cache clean --force
COPY --from=build /app/dist ./dist
USER node
ENV HOME=/home/node
ENTRYPOINT ["node", "dist/mcp-ocado.js"]
