# Egress proxy: the only route out for the MCP container.
# Alpine 3.24: main and community supported until 2028-06-01 (alpinelinux.org/releases).
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache tinyproxy=1.11.3-r0
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY egress-allowlist.txt /etc/tinyproxy/filter
USER tinyproxy
EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
